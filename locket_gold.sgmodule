#!name=Locket Gold Ultra Universal Unlock v5.0
#!desc=Mở khóa Locket Gold toàn diện: Photobooth 4 Ô (Life 4 Cuts), 57 Khung viền widget, 38 VIP Camera Filters & AR Stickers, Video 30s CÓ ÂM THANH (Built-in Mic), Đăng từ Album/Thư viện, Xem ai đã xem, Đổi icon app, Caption dài vô hạn, Huy hiệu Vương miện Gold, Chặn quảng cáo & Paywall.
#!category=Tweak

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[Rule]
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,firebaseremoteconfigrealtime.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN,api.revenuecat.com,DIRECT
DOMAIN,firebaseremoteconfig.googleapis.com,DIRECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,DIRECT
DOMAIN,us-central1-locket-4252a.cloudfunctions.net,DIRECT

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-Modified-Since
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+ header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+ header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-replace Cache-Control no-cache

[Script]
Locket_Res = type=http-response,pattern=^https?:\/\/(api\.revenuecat\.com\/.+|firebaseremoteconfig\.googleapis\.com\/.+|firebaseremoteconfigrealtime\.googleapis\.com\/.+|us-central1-locket-4252a\.cloudfunctions\.net\/.+),script-path=https://cdn.jsdelivr.net/gh/huanminh254/locket-gold@v5.0/locket_gold.js,requires-body=true,max-size=3145728,timeout=60,enable=true

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, firebaseremoteconfigrealtime.googleapis.com, us-central1-locket-4252a.cloudfunctions.net
enable = true
