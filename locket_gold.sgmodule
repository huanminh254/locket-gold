#!name=Locket Gold Universal Unlock
#!desc=Mở khóa Locket Gold toàn diện (Video 30s, Camera Roll, Xem ai xem, Custom Icon, Caption dài, Huy hiệu Gold, Chặn quảng cáo)
#!category=Tweak

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-Modified-Since
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+ header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+ header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-replace Cache-Control no-cache

[Script]
Locket_Req = type=http-request,pattern=^https?:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers|offerings|product_entitlement_mapping)|firebaseremoteconfig\.googleapis\.com\/.+),script-path=https://cdn.jsdelivr.net/gh/huanminh254/locket-gold@main/locket_gold.js,timeout=30
Locket_Res = type=http-response,pattern=^https?:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers\/[^/]+|offerings|product_entitlement_mapping)|firebaseremoteconfig\.googleapis\.com\/.+),script-path=https://cdn.jsdelivr.net/gh/huanminh254/locket-gold@main/locket_gold.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
