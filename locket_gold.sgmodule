#!name=Locket Gold Ultra Universal Unlock v6.1
#!desc=Mở khóa Locket Gold toàn diện: Photobooth 4 Ô (Classic Film, Pastel Cute, Life 4 Cuts, 1-Cut, 2-Cut, Palette, Polaroid), 57 Khung viền widget, 38 VIP Camera Filters & AR Stickers, Video 30s CÓ ÂM THANH (Mic chuẩn iOS), Đăng ảnh/video Album 30s, Xem ai đã xem, Đổi icon app, Caption dài, Huy hiệu Vương miện Gold, Chặn quảng cáo & Paywall.
#!category=Tweak

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[Rule]
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,firebaseremoteconfigrealtime.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN,api.revenuecat.com,DIRECT
DOMAIN,firebaseremoteconfig.googleapis.com,DIRECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,DIRECT
DOMAIN,api.locketcamera.com,DIRECT
DOMAIN,us-central1-locket-4252a.cloudfunctions.net,DIRECT

[URL Rewrite]
^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage https://locket-vip.mhiep20077.workers.dev/generateFilteredImage?module=Locket_Only_Cold 307

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+ header-del If-Modified-Since
^https?:\/\/api\.revenuecat\.com\/.+ header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+ header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+ header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfigrealtime\.googleapis\.com\/.+ header-replace Cache-Control no-cache

^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-replace Cache-Control no-cache

[Script]
Locket_Req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(generateFilteredImage|getFilters|createFilter|applyFilter|createOverlay),script-path=https://cdn.jsdelivr.net/gh/huanminh254/locket-gold@main/locket_gold.js,timeout=30,enable=true
Locket_Res = type=http-response,pattern=^https?:\/\/(api\.revenuecat\.com\/.+|firebaseremoteconfig\.googleapis\.com\/.+|firebaseremoteconfigrealtime\.googleapis\.com\/.+|us-central1-locket-4252a\.cloudfunctions\.net\/.+|api\.locketcamera\.com\/.+),script-path=https://cdn.jsdelivr.net/gh/huanminh254/locket-gold@main/locket_gold.js,requires-body=true,max-size=3145728,timeout=60,enable=true

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, firebaseremoteconfigrealtime.googleapis.com, api.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
enable = true
